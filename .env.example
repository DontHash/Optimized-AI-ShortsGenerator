# LLM provider for highlight ranking — gemini is the free-first default (free tier)
LLM_PROVIDER=gemini           # openai or gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# LLM resilience: retry transient errors, then fall back to the other provider if keyed
LLM_MAX_RETRIES=3
LLM_FALLBACK=true

# Whisper
LOCAL_WHISPER_MODEL=base      # tiny / base / small / medium / large-v3
LOCAL_WHISPER_DEVICE=auto     # auto / cpu / cuda

# Output / download
LOCAL_OUTPUT_DIR=output
DOWNLOAD_FORMAT=max           # max (uncapped) | 360 / 480 / 720 / 1080

# Anti-403 / HD unlock (yt-dlp). Auto-detects cookies.json or cookies.txt in project root.
# File cookies beat browser cookies (no need to close Edge). Set browser to none if using a file.
YTDLP_COOKIES_FROM_BROWSER=edge
# File cookies beat browser cookies. Leave blank to auto-use cookies.json in project root.
YTDLP_COOKIES_FILE=
# comma list; blank = tv,mweb,web,ios,web_safari,android
YTDLP_PLAYER_CLIENTS=

# Signal-fusion reranker (see docs/UPLIFT_PLAN.md) — missing signals renormalize
RERANK_WEIGHTS=llm:0.45,replay:0.25,audio:0.20,chapter:0.10
AUDIO_ENERGY=true             # ffmpeg+numpy loudness/spike/pause scoring
DEDUPE_SIMILARITY=0.6         # drop clips whose transcripts overlap more than this

# Context-aware peak expansion (capture the setup that leads into a replay peak)
PEAK_LEAD_SECONDS=5           # minimum lead-in before a peak
PEAK_LEAD_MAX_SECONDS=20      # cap on how far back to reach for setup
PEAK_TAIL_SECONDS=5           # padding after the peak/payoff
MAX_CLIP_SECONDS=180          # hard ceiling; tail trimmed first, lead-in kept

# Free path: use YouTube auto-captions instead of local Whisper when available
AUTO_SUBS=true               # false = always run faster-whisper
AUTO_SUBS_LANGS=en           # comma list, e.g. en,en-orig (falls back to Whisper if absent)

# SponsorBlock: exclude sponsor/intro/outro/selfpromo segments from clips
SPONSORBLOCK=true

# Captions (used by captions.py)
CAPTION_FONT=Arial
CAPTION_FONT_SIZE=48
CAPTION_HIGHLIGHT_COLOR=&H0000FFFF
CAPTION_MAX_WORDS=3
